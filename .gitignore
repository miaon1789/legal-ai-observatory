# the reasons behind it do not belong in the record.
LEGAL_AI_OBSERVATORY_BRIEF.md
DATA_MODEL_DECISIONS_V2.md
DATA_MODEL_DECISIONS*.md
private/
# Raw contracts, individual logs, exports and private PBIX copies stay here.
*.zh.md
notes_cn/

# --- env / secrets ---
.venv/
.env
*.env
.env.*
!.env.example
secrets.json
*.pem
*.key
*.p12
*.pfx

